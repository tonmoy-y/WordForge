{
  "appId": "com.tonmoy.wordforge",
  "productName": "WordForge",
  "copyright": "Copyright © 2026 WordForge Contributors",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "afterPack": "scripts/afterPack.js",
  "mac": {
    "category": "public.app-category.productivity",
    "target": [
      {
        "target": "dir",
        "arch": ["arm64"]
      },
      {
        "target": "dmg",
        "arch": ["arm64"]
      },
      {
        "target": "zip",
        "arch": ["arm64"]
      }
    ],
    "identity": null
  },
  "publish": [
    {
      "provider": "github",
      "owner": "tonmoy-y",
      "repo": "WordForge",
      "releaseType": "release"
    }
  ]
}
