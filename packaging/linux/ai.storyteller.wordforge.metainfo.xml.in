<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>ai.storyteller.wordforge</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>WordForge</name>
  <summary>Write and design documents; open and save Word files</summary>
  <developer id="ai.storyteller">
    <name>WordForge</name>
  </developer>
  <description>
    <p>
      WordForge is a fast, open-source word processor with a familiar ribbon: styles, tables, track changes, references, mail merge, and .docx, PDF, ODT, RTF, HTML and Markdown files. It can be driven by AI agents over MCP.
    </p>
  </description>
  <launchable type="desktop-id">ai.storyteller.wordforge.desktop</launchable>
  <icon type="stock">ai.storyteller.wordforge</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/tonmoy-y/WordForge</url>
  <url type="bugtracker">https://github.com/tonmoy-y/WordForge/issues</url>
  <url type="help">https://github.com/tonmoy-y/WordForge</url>
  <url type="contact">https://github.com/tonmoy-y/WordForge</url>
  <categories>
    <category>Office</category>
    <category>WordProcessor</category>
  </categories>
  <keywords>
    <keyword>word processor</keyword>
    <keyword>docx</keyword>
    <keyword>document</keyword>
    <keyword>writer</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>The Open Studio Handbook sample with the Navigation pane</caption>
      <image>https://raw.githubusercontent.com/tonmoy-y/WordForge/main/docs/images/hero.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#b9c7f5</color>
    <color type="primary" scheme_preference="dark">#2b47b5</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>wordforge</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
